# ======================================================================
#  Pizza Shop - server configuration
#  Copy this file to ".env" (same folder) and edit the values.
# ======================================================================

# ---- Server ----------------------------------------------------------
PORT=5000
NODE_ENV=development
# Long random string used to sign admin login tokens. CHANGE THIS.
JWT_SECRET=change-this-to-a-long-random-string
# Allowed browser origins for the API (comma separated). "*" allows all.
CORS_ORIGIN=http://localhost:5173

# ---- Database --------------------------------------------------------
# DB_CLIENT=mysql2  -> real MySQL server (use this on the deployment machine)
# DB_CLIENT=sqlite  -> local demo / testing WITHOUT MySQL (file created automatically)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pizza_shop

# Only used when DB_CLIENT=sqlite (path relative to the server folder)
# SQLITE_FILE=data/pizza-shop.sqlite

# ---- Shop settings ---------------------------------------------------
SHOP_NAME=Slice of Heaven
CURRENCY_SYMBOL=₹
# 0.05 = 5% tax added on the subtotal
TAX_RATE=0.05
DELIVERY_FEE=40
# Orders with a subtotal at or above this amount get free delivery (0 disables)
FREE_DELIVERY_OVER=500

# ---- Initial admin user (created by "npm run db:seed") ---------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
